{
  "name": "game-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo berisi beberapa game, masing-masing dirilis sebagai APK sendiri",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "site": "node scripts/build-site.mjs",
    "icon": "node scripts/make-icon.mjs",
    "games": "node scripts/list-games.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
